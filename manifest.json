{
  "manifest_version": 2,
  "name": "Web2Trilium",
  "version": "1.0.8",
  "description": "Browse your Firefox bookmarks and open tabs, and send any of them to Trilium's Inbox with one click.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "Open Web2Trilium"
  },
  "sidebar_action": {
    "default_panel": "manage.html",
    "default_icon": "icons/icon-48.png",
    "default_title": "Web2Trilium"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "trilium-inbox-saver@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}